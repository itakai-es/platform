generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== USERS & AUTH ====================

enum UserRole {
  student
  teacher
  admin
}

enum UserStatus {
  active
  suspended
  inactive
}

// Quién lleva la cuenta: `self`, su propio dueño, que se registró con su correo;
// `managed`, el profesorado, que la creó para alguien que no tiene correo.
enum UserAccountType {
  self
  managed
}

// Una cuenta entra con su correo o con su usuario. Los dos son opcionales por
// separado, pero no a la vez: lo garantiza el CHECK `users_email_or_username`,
// que Prisma no sabe expresar y vive en la migración
// `20260917150000_optional_email_and_username`. El correo se guarda siempre en
// minúsculas (lo normaliza la aplicación, ver utils/identity.ts).
model User {
  id                 String          @id @default(uuid())
  email              String?         @unique
  username           String?         @unique
  passwordHash       String          @map("password_hash")
  name               String
  role               UserRole?
  accountType        UserAccountType @default(self) @map("account_type")
  isOnboarded        Boolean         @default(false) @map("is_onboarded")
  status             UserStatus      @default(active)
  // Quién creó la cuenta y en qué clase nació: quien tiene administración en esa
  // clase es quien la gestiona. Las dos se quedan en null si se borra la fila
  // apuntada, para no arrastrar el borrado a la cuenta del alumno.
  createdById        String?         @map("created_by_id")
  homeClassId        String?         @map("home_class_id")
  mustChangePassword Boolean         @default(false) @map("must_change_password")
  passwordChangedAt  DateTime?       @map("password_changed_at")
  /// Avatar del profesorado: clave del catálogo docente (hoy, un color de la
  /// paleta: «purple», «mint»…), nunca una ruta ni una URL. Nulo = sin elegir:
  /// iniciales sobre un color derivado del id. Lo valida la API (utils/avatars.ts).
  avatar             String?
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  // Relations
  createdBy         User?               @relation("CreatedUsers", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers      User[]              @relation("CreatedUsers")
  homeClass         Class?              @relation("HomeClassStudents", fields: [homeClassId], references: [id], onDelete: SetNull)
  refreshTokens     RefreshToken[]
  teacherClasses    Class[]             @relation("TeacherClasses")
  trashedClasses    Class[]             @relation("TrashedClasses")
  recommendedTemplates Class[]          @relation("RecommendedTemplates")
  enrollments       ClassEnrollment[]
  createdBadges     Badge[]             @relation("CreatedBadges")
  earnedBadges      StudentBadge[]
  missionProgress   StudentMissionProgress[]
  enigmaProgress    StudentEnigmaProgress[]
  notifications     Notification[]
  activities        Activity[]
  conversations     ChatConversation[]
  joinRequests      JoinRequest[]
  sentInvitations   Invitation[]        @relation("SentInvitations")
  receivedInvitations Invitation[]      @relation("ReceivedInvitations")
  submissions       EnigmaSubmission[]  @relation("StudentSubmissions")
  settings          UserSettings?
  shopPurchases     ShopPurchase[]
  shopItemUses      ShopItemUse[]
  missionHintUses   MissionHintUse[]
  behaviorsApplied  BehaviorApplication[] @relation("BehaviorTeacher")
  submissionsReviewed EnigmaSubmission[] @relation("SubmissionReviewer")
  activitiesActed   Activity[]          @relation("ActivityActor")
  behaviorsReceived BehaviorApplication[] @relation("BehaviorStudent")
  attendanceTaken      AttendanceSession[]      @relation("AttendanceTakenBy")
  attendanceUpdated    AttendanceRecord[]       @relation("AttendanceUpdatedBy")
  teamAwardsGiven      TeamAward[]              @relation("TeamAwardTeacher")
  classTeachers      ClassTeacher[]   @relation("ClassTeacherUser")
  classTeachersAdded ClassTeacher[]   @relation("ClassTeacherAddedBy")
  classActions       ClassActionLog[] @relation("ClassActionActor")
  classActionsTarget ClassActionLog[] @relation("ClassActionTarget")

  @@index([createdById])
  @@index([homeClassId])
  @@index([accountType])
  @@map("users")
}

model UserSettings {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  twoFactorEnabled   Boolean  @default(false) @map("two_factor_enabled")
  emailNotifications Boolean  @default(true) @map("email_notifications")
  missionReminders   Boolean  @default(true) @map("mission_reminders")
  language           String   @default("es")
  theme              String   @default("college")
  menuDisplay        String   @default("both") @map("menu_display")
  // Accesibilidad (Fase 3, punto 14). Se guardan como texto libre y se validan
  // en la ruta: añadir un modo nuevo no obliga a migrar la base de datos.
  fontScale          String   @default("normal") @map("font_scale")
  contrastMode       String   @default("normal") @map("contrast_mode")
  colorVision        String   @default("default") @map("color_vision")
  reduceMotion       Boolean  @default(false) @map("reduce_motion")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model RefreshToken {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String   @map("user_id")
  family      String   @default(uuid()) // Token family for rotation tracking
  isRevoked   Boolean  @default(false) @map("is_revoked")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")
  userAgent   String?  @map("user_agent")
  ipAddress   String?  @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([family])
  @@map("refresh_tokens")
}

// ==================== INSTANCE SETTINGS ====================

// Configuración global de la instancia editable desde el panel de administración.
// Una fila por sección (ai | storage | domain | general). Los secretos (API keys,
// claves de R2) viajan cifrados dentro del JSON (ver config/crypto.ts). Permite el
// auto-hospedaje: la config deja de depender de editar .env a mano.
model InstanceSetting {
  section   String   @id
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("instance_settings")
}

// ==================== CLASSES ====================

model Class {
  id              String    @id @default(uuid())
  name            String
  narrative       String?
  schedule        String?
  archived        Boolean   @default(false)
  invitationCode  String    @unique @map("invitation_code")
  backgroundImage String?   @map("background_image")
  // Metadatos de clasificación (editables por el profe; alimentan los filtros del
  // marketplace de plantillas). Opcionales; se exigirán al publicar como plantilla.
  subject         String?
  language        String?
  educationLevel  String?   @map("education_level")
  province        String?
  // Publicada como plantilla pública en el marketplace (otros profes pueden importarla).
  isTemplate      Boolean   @default(false) @map("is_template")
  settings        Json      @default("{}")
  // Configuración del sistema de niveles por clase (curva de XP + tramos visuales).
  // Nulo = usa los valores por defecto (DEFAULT_LEVEL_CONFIG), retrocompatible.
  levelConfig     Json?     @map("level_config")
  // Configuración de horario/calendario (recurrencia estilo Google + fechas +
  // overrides por día). Nulo = sin horario configurado.
  scheduleConfig  Json?     @map("schedule_config")
  // Propietario de la clase. Coincide siempre con la fila `isOwner` de
  // `ClassTeacher`: las dos se escriben juntas (ver utils/class-owner.ts).
  teacherId       String    @map("teacher_id")
  // Papelera: con fecha, la clase está en ella y sale de todos los listados; la
  // purga la borra del todo a los 30 días. Al enviarla se archiva y se retira
  // del marketplace; restaurarla la deja archivada. `deletedById` es quién la
  // envió, y se queda en null si se borra esa cuenta.
  deletedAt       DateTime? @map("deleted_at")
  deletedById     String?   @map("deleted_by_id")
  // Cuándo se avisó a quien tiene la propiedad de que la purga se acerca (ver
  // class-trash.jobs.ts). Restaurarla o volver a enviarla lo deja en null.
  trashWarnedAt   DateTime? @map("trash_warned_at")
  // Plantilla recomendada por la administración de la instancia: con fecha,
  // sale primero en los catálogos con su distintivo. Retirarla o enviarla a la
  // papelera le quita la marca, que no vuelve sola al publicarla otra vez.
  // `recommendedById` es quién la marcó, y se queda en null si se borra esa cuenta.
  recommendedAt   DateTime? @map("recommended_at")
  recommendedById String?   @map("recommended_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  teacher       User              @relation("TeacherClasses", fields: [teacherId], references: [id])
  deletedBy     User?             @relation("TrashedClasses", fields: [deletedById], references: [id], onDelete: SetNull)
  recommendedBy User?             @relation("RecommendedTemplates", fields: [recommendedById], references: [id], onDelete: SetNull)
  enrollments   ClassEnrollment[]
  missions      Mission[]
  guide         ClassGuide?
  joinRequests  JoinRequest[]
  invitations   Invitation[]
  shopItems     ShopItem[]
  shopPurchases ShopPurchase[]
  shopItemUses  ShopItemUse[]
  behaviorTemplates    BehaviorTemplate[]
  behaviorApplications BehaviorApplication[]
  attendanceSessions   AttendanceSession[]
  teamSets             TeamSet[]
  teachers      ClassTeacher[]
  actionLog     ClassActionLog[]
  // Cuentas de alumnado creadas en esta clase: es la clase desde la que se gestionan.
  homeStudents  User[]            @relation("HomeClassStudents")

  @@index([teacherId])
  @@map("classes")
}

/** Hasta dónde llega un profesor en una clase. Cada nivel incluye los anteriores. */
enum ClassAccessLevel {
  read
  edit
  admin
}

/** Etiqueta del profesor en la clase. Sugiere un nivel, pero no lo impone. */
enum ClassTeacherProfile {
  titular
  sustituto
  practicas
}

// Profesorado de una clase: una fila por profesor con acceso. El propietario es
// la fila con `isOwner` y hay exactamente uno por clase. Eso lo garantiza un
// índice único parcial que Prisma no sabe expresar y que vive solo en el SQL de
// la migración: `class_teachers_one_owner ON class_teachers(class_id) WHERE is_owner`.
// Prisma tampoco lo ve al comparar con la base, así que hoy no propone borrarlo;
// si alguna versión lo hiciera, se quita esa sentencia a mano
// (tests/migrations/class_teachers.test.ts vigila que siga en la migración).
model ClassTeacher {
  id        String              @id @default(uuid())
  classId   String              @map("class_id")
  userId    String              @map("user_id")
  access    ClassAccessLevel
  profile   ClassTeacherProfile
  isOwner   Boolean             @default(false) @map("is_owner")
  addedById String?             @map("added_by_id")
  /** Fin del acceso. Pasada esta fecha la fila deja de contar, sin borrarse. */
  endsAt    DateTime?           @map("ends_at")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user    User  @relation("ClassTeacherUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User? @relation("ClassTeacherAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([classId, userId])
  @@index([userId])
  @@map("class_teachers")
}

// Registro de lo que hace el profesorado en una clase. Guarda una copia del
// nombre y del avatar de quien actuó para que la entrada se siga leyendo si esa
// cuenta desaparece. `metadata` nunca lleva nombres de alumnos: al alumno se le
// referencia con `targetUserId`. Se borra con la clase.
model ClassActionLog {
  id           String   @id @default(uuid())
  classId      String   @map("class_id")
  actorId      String?  @map("actor_id")
  actorName    String   @map("actor_name")
  actorAvatar  String?  @map("actor_avatar")
  /** Clave `dominio.verbo`, p. ej. `submission.approved`. */
  action       String
  entityType   String?  @map("entity_type")
  entityId     String?  @map("entity_id")
  targetUserId String?  @map("target_user_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  class      Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  actor      User? @relation("ClassActionActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User? @relation("ClassActionTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([classId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("class_action_log")
}

model ClassEnrollment {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  classId    String   @map("class_id")
  xp         Int      @default(0)
  coins      Int      @default(0) // Spendable balance earned from enigma rewards, spent in the class shop
  mana       Int      @default(0) // Spendable balance earned from enigma rewards (independent of XP and coins)
  lives      Int      @default(100) // Class life points, modified by positive/negative behaviors
  level      Int      @default(1)
  nickname   String?  // Class-specific nickname (e.g., "MateMaster99")
  avatarUrl  String?  @map("avatar_url") // Class-specific avatar (default, preset, or AI-generated)
  // Matrícula "fantasma": el profesor se auto-matricula en su propia clase para
  // probarla como un alumno. Se excluye de listados/recuentos/rankings.
  isPreview  Boolean  @default(false) @map("is_preview")
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]
  teamMemberships   TeamMember[]

  @@unique([studentId, classId])
  @@index([classId, isPreview])
  @@map("class_enrollments")
}

model ClassGuide {
  id          String   @id @default(uuid())
  classId     String   @unique @map("class_id")
  content     String   @db.Text
  lastUpdated DateTime @default(now()) @map("last_updated")

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("class_guides")
}

// ==================== SHOP (per-class rewards bought with coins) ====================

model ShopItem {
  id          String   @id @default(uuid())
  classId     String   @map("class_id")
  name        String
  description String   @default("")
  price       Int
  active      Boolean  @default(true) // Visible to students
  kind        String   @default("reward") // "reward" (buy with coins) | "power" (buy with coins, used by spending mana)
  manaCost    Int      @default(0) @map("mana_cost") // Mana spent per use (powers only)
  usage       String   @default("single") // "single" (consumed on redeem) | "unlimited" (kept) — rewards only
  lifeRestore Int      @default(0) @map("life_restore") // Lives the item restores: applied on purchase (rewards) or on use (powers)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  purchases ShopPurchase[]
  uses      ShopItemUse[]

  @@index([classId])
  @@map("shop_items")
}

model ShopPurchase {
  id        String   @id @default(uuid())
  classId   String   @map("class_id")
  itemId    String?  @map("item_id") // nullable: keep history if the item is later deleted
  studentId String   @map("student_id")
  itemName  String   @map("item_name") // snapshot of the name at purchase time
  price     Int
  createdAt DateTime @default(now()) @map("created_at")

  class   Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  item    ShopItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  student User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([studentId, classId])
  @@map("shop_purchases")
}

// Each time a student uses a power (spending mana). Lets the teacher see usage.
model ShopItemUse {
  id        String   @id @default(uuid())
  classId   String   @map("class_id")
  itemId    String?  @map("item_id") // nullable: keep history if the item is later deleted
  studentId String   @map("student_id")
  itemName  String   @map("item_name") // snapshot of the name at use time
  manaCost  Int      @map("mana_cost") // mana spent at use time
  createdAt DateTime @default(now()) @map("created_at")

  class   Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  item    ShopItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  student User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([studentId, classId])
  @@map("shop_item_uses")
}

// ==================== MISSIONS ====================

enum MissionStatus {
  activa
  bloqueada
}

enum MissionRarity {
  comun
  rara
  epica
  legendaria
}

model Mission {
  id              String            @id @default(uuid())
  classId         String            @map("class_id")
  title           String
  description     String?
  status          MissionStatus     @default(activa)
  rarity          MissionRarity     @default(comun)
  backgroundImage String?           @map("background_image")
  deadline        DateTime?
  // Se hace por equipos de esta agrupación: solo informativo (el alumnado lo ve
  // y el profesorado puede aprobar a todo un equipo de una vez); cada estudiante
  // sigue entregando lo suyo. No se copia entre clases: son estudiantes concretos.
  teamSetId       String?       @map("team_set_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  class     Class                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teamSet   TeamSet?                 @relation(fields: [teamSetId], references: [id], onDelete: SetNull)
  enigmas   MissionEnigma[]
  badges    Badge[]
  progress  StudentMissionProgress[]
  documents MissionDocument[]
  hints     MissionHint[]
  hintUses  MissionHintUse[]

  @@map("missions")
}

model MissionDocument {
  id          String   @id @default(uuid())
  missionId   String   @map("mission_id")
  name        String
  description String?
  fileUrl     String   @map("file_url")
  fileName    String   @map("file_name")
  fileSize    Int      @map("file_size")
  mimeType    String   @map("mime_type")
  tags        String[] @default([])
  orderIndex  Int      @default(0) @map("order_index")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@map("mission_documents")
}

enum EnigmaStatus {
  pendiente
  en_progreso
  completado
}

model MissionEnigma {
  id             String       @id @default(uuid())
  missionId      String       @map("mission_id")
  title          String
  description    String?
  objectives     String[]     @default([])
  isOptional     Boolean      @default(false) @map("is_optional")
  xpReward       Int          @default(0) @map("xp_reward")
  coinReward     Int          @default(0) @map("coin_reward")
  manaReward     Int          @default(0) @map("mana_reward")
  orderIndex     Int          @default(0) @map("order_index")

  mission     Mission                 @relation(fields: [missionId], references: [id], onDelete: Cascade)
  progress    StudentEnigmaProgress[]
  submissions EnigmaSubmission[]

  @@map("mission_enigmas")
}

model StudentEnigmaProgress {
  id          String    @id @default(uuid())
  studentId   String    @map("student_id")
  enigmaId    String    @map("enigma_id")
  completedAt DateTime  @default(now()) @map("completed_at")
  xpEarned    Int       @default(0) @map("xp_earned")
  coinsEarned Int       @default(0) @map("coins_earned")
  manaEarned  Int       @default(0) @map("mana_earned")
  percentage  Int       @default(100) // Completion % the teacher graded (0-100); scales every reward
  // % que restaban las pistas de % de la misión al aprobarlo (suma con tope 100).
  // Se guarda para que subir después la recompensa del enigma no devuelva el descuento.
  hintPenalty Int       @default(0) @map("hint_penalty")

  student User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enigma  MissionEnigma @relation(fields: [enigmaId], references: [id], onDelete: Cascade)

  @@unique([studentId, enigmaId])
  @@map("student_enigma_progress")
}

// Pistas de una misión, en el orden que fija el profesorado. Cada una cuesta
// monedas, XP o un % de lo que la misión aún tiene que pagar a quien la usa.
model MissionHint {
  id         String   @id @default(uuid())
  missionId  String   @map("mission_id")
  content    String
  orderIndex Int      @default(0) @map("order_index")
  costType   String   @default("coins") @map("cost_type") // "coins" | "xp" | "percent"
  cost       Int      @default(0) // monedas o XP; con "percent", de 0 a 100
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  mission Mission          @relation(fields: [missionId], references: [id], onDelete: Cascade)
  uses    MissionHintUse[]

  @@index([missionId, orderIndex])
  @@map("mission_hints")
}

// Cada pista que ha usado un estudiante, con lo que costó en ese momento: lo
// cobrado (monedas o XP) o el % aplicado. Una pista usada no se borra.
model MissionHintUse {
  id        String   @id @default(uuid())
  hintId    String   @map("hint_id")
  missionId String   @map("mission_id")
  studentId String   @map("student_id")
  costType  String   @map("cost_type")
  cost      Int
  createdAt DateTime @default(now()) @map("created_at")

  // Sin cascada desde la pista: la base no deja borrar una pista usada, ni
  // aunque el borrado llegue a la vez que el uso. Al borrar la misión o la clase
  // los usos se van con ella (la comprobación es al final de la sentencia).
  hint    MissionHint @relation(fields: [hintId], references: [id], onDelete: NoAction)
  mission Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  student User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([hintId, studentId])
  @@index([missionId, studentId])
  @@map("mission_hint_uses")
}

enum SubmissionStatus {
  pendiente
  aprobada
}

model EnigmaSubmission {
  id          String           @id @default(uuid())
  studentId   String           @map("student_id")
  enigmaId    String           @map("enigma_id")
  fileUrl     String?          @map("file_url")
  fileName    String?          @map("file_name")
  fileSize    Int?             @map("file_size")
  status      SubmissionStatus @default(pendiente)
  xpAwarded   Int?             @map("xp_awarded")
  submittedAt DateTime         @default(now()) @map("submitted_at")
  reviewedAt  DateTime?        @map("reviewed_at")
  // Quién la aprobó. Se queda en null si esa cuenta se borra: la entrega sigue aprobada.
  reviewedById String?         @map("reviewed_by_id")

  student    User          @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  enigma     MissionEnigma @relation(fields: [enigmaId], references: [id], onDelete: Cascade)
  reviewedBy User?         @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@map("enigma_submissions")
}

model StudentMissionProgress {
  id          String    @id @default(uuid())
  studentId   String    @map("student_id")
  missionId   String    @map("mission_id")
  progress    Int       @default(0) // 0-100
  enigmasCompleted Int  @default(0) @map("enigmas_completed")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([studentId, missionId])
  @@map("student_mission_progress")
}

// ==================== BADGES & ACHIEVEMENTS ====================

model Badge {
  id           String   @id @default(uuid())
  name         String
  description  String?
  imageUrl     String?  @map("image_url")
  rarity       String   @default("common") // common, rare, epic, legendary
  category     String   @default("missions") // missions, streak, xp, social, level
  teacherId    String?  @map("teacher_id")
  missionId    String?  @map("mission_id")
  // Auto-unlock trigger for system badges (null = manually awarded).
  // Types: "missions_completed", "xp_total", "level_reached".
  triggerType  String?  @map("trigger_type")
  triggerValue Int?     @map("trigger_value")
  createdAt    DateTime @default(now()) @map("created_at")

  // Sin autor, una insignia es del sistema: por eso borrar la cuenta del autor no
  // puede dejarla en null. La base lo impide y el borrado de la cuenta la pasa
  // antes a quien corresponda (ver reassignBadges en
  // modules/profile/account-deletion.service.ts).
  teacher  User?          @relation("CreatedBadges", fields: [teacherId], references: [id], onDelete: Restrict)
  mission  Mission?       @relation(fields: [missionId], references: [id])
  students StudentBadge[]

  @@index([triggerType, triggerValue])
  @@map("badges")
}

model StudentBadge {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  badgeId   String   @map("badge_id")
  earnedAt  DateTime @default(now()) @map("earned_at")

  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badge   Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([studentId, badgeId])
  @@map("student_badges")
}

// ==================== ENROLLMENTS ====================

// Solicitudes para unirse e invitaciones personales: ninguna ruta las crea ni las
// lee ya (con el código de clase se entra directamente). Las tablas se conservan
// con lo que tengan, y borrar una cuenta o una clase arrastra sus filas.

enum JoinRequestStatus {
  pending
  accepted
  rejected
}

model JoinRequest {
  id              String            @id @default(uuid())
  studentId       String            @map("student_id")
  classId         String            @map("class_id")
  status          JoinRequestStatus @default(pending)
  message         String?
  rejectionReason String?           @map("rejection_reason")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("join_requests")
}

enum InvitationStatus {
  pending
  accepted
  rejected
  expired
}

model Invitation {
  id        String           @id @default(uuid())
  classId   String           @map("class_id")
  teacherId String           @map("teacher_id")
  studentId String           @map("student_id")
  status    InvitationStatus @default(pending)
  message   String?
  expiresAt DateTime?        @map("expires_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User  @relation("SentInvitations", fields: [teacherId], references: [id], onDelete: Cascade)
  student User  @relation("ReceivedInvitations", fields: [studentId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

// ==================== NOTIFICATIONS ====================

enum NotificationType {
  mission_assigned
  mission_completed
  badge_earned
  level_up
  class_invitation
  deadline_reminder
  join_request
  join_accepted
  join_rejected
  achievement_unlocked
  system_announcement
  chat_message
  // Entregas (Fase 3, punto 3): el profesor recibe el aviso de que hay algo que
  // revisar y el alumno la confirmación de que ya se ha revisado.
  submission_received
  submission_reviewed
  // Profesorado de una clase: al afectado le llega lo que cambia de su acceso.
  class_teacher_added
  class_teacher_changed
  class_teacher_removed
  class_ownership_received
  // Papelera de clases: a quien tiene la propiedad, unos días antes de la purga.
  class_purge_soon
}

enum NotificationPriority {
  low
  medium
  high
  urgent
}

model Notification {
  id        String               @id @default(uuid())
  userId    String               @map("user_id")
  type      NotificationType
  title     String
  message   String
  priority  NotificationPriority @default(medium)
  isRead    Boolean              @default(false) @map("is_read")
  actionUrl String?              @map("action_url")
  metadata  Json?
  expiresAt DateTime?            @map("expires_at")
  createdAt DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Los avisos se leen siempre por destinatario: la lista, los no leídos y
  // marcarlos como leídos.
  @@index([userId, isRead])
  @@map("notifications")
}

// ==================== ACTIVITIES ====================

enum ActivityType {
  mission_completed
  mission_started
  level_up
  badge_earned
  class_joined
  xp_gained
  enigma_submitted
  enigma_completed
  achievement_unlocked
  student_enrolled
  progress_milestone
  behavior_applied
  shop_purchased
  shop_item_used
  hint_used
}

model Activity {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")

  // Class-specific student profile (from ClassEnrollment)
  avatar      String?      // Student's avatar in the class where activity occurred
  username    String?      // Student's nickname in the class
  classId     String?      @map("class_id") // Class where activity occurred

  // Activity-specific fields
  enigmaTitle   String?  @map("enigma_title")
  enigmaXp      Int?     @map("enigma_xp")
  missionTitle  String?  @map("mission_title")
  missionXp     Int?     @map("mission_xp")
  newLevel      Int?     @map("new_level")
  newTitle      String?  @map("new_title")
  className     String?  @map("class_name")
  teacherName   String?  @map("teacher_name")
  badgeName     String?  @map("badge_name")
  badgeRarity   String?  @map("badge_rarity")
  badgeImage    String?  @map("badge_image")
  achievementName String? @map("achievement_name")
  xpAmount      Int?     @map("xp_amount")
  source        String?

  // Quién hizo lo que cuenta la entrada, cuando no es el propio alumno: el
  // profesor que aprobó la entrega o aplicó el comportamiento. El nombre se copia
  // para que la entrada se siga leyendo si esa cuenta se borra.
  actorId       String?  @map("actor_id")
  actorName     String?  @map("actor_name")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([classId, createdAt])
  @@map("activities")
}

// ==================== SYSTEM LOGS ====================

enum SystemLogLevel {
  info
  warning
  error
  success
}

enum SystemLogCategory {
  health_check
  service_status
  security
  performance
  maintenance
  backup
}

model SystemLog {
  id        String              @id @default(uuid())
  level     SystemLogLevel
  category  SystemLogCategory
  title     String
  message   String
  service   String?
  metadata  Json?
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([level])
  @@index([category])
  @@map("system_logs")
}

// ==================== CHAT ====================

enum AssistantId {
  atenea
  odiseo
  penelope
  polifemo
  poseidon
}

model ChatConversation {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  assistantId AssistantId @map("assistant_id")
  title       String?
  missionId   String?     @map("mission_id")
  classId     String?     @map("class_id")
  archived    Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chat_conversations")
}

enum MessageRole {
  user
  assistant
}

model ChatMessage {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String      @db.Text
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// ==================== BEHAVIORS (per-class positive/negative actions) ====================

model BehaviorTemplate {
  id          String   @id @default(uuid())
  classId     String   @map("class_id")
  kind        String   // "positive" | "negative"
  name        String
  description String   @default("")
  xpDelta     Int      @default(0) @map("xp_delta")
  coinDelta   Int      @default(0) @map("coin_delta")
  lifeDelta   Int      @default(0) @map("life_delta")
  manaDelta   Int      @default(0) @map("mana_delta")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  class        Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  applications BehaviorApplication[]
  teamAwards   TeamAward[]

  @@index([classId])
  @@map("behavior_templates")
}

model BehaviorApplication {
  id         String   @id @default(uuid())
  classId    String   @map("class_id")
  behaviorId String?  @map("behavior_id")
  // Quién lo aplicó. Si esa cuenta se borra, la aplicación se conserva sin autor.
  teacherId  String?  @map("teacher_id")
  studentId  String   @map("student_id")
  // "positive" | "negative", copiado de la plantilla; "reward" para una
  // recompensa libre (sin plantilla: behaviorId nulo y el motivo en `name`).
  kind        String
  name        String // Copia del nombre de la plantilla, o el motivo de la recompensa
  xpDelta    Int      @map("xp_delta")
  coinDelta  Int      @map("coin_delta")
  lifeDelta  Int      @map("life_delta")
  manaDelta   Int      @default(0) @map("mana_delta")
  // Vino del reparto de un premio de equipo. Si el premio se borra (con su
  // equipo), la aplicación se conserva suelta.
  teamAwardId String?  @map("team_award_id")
  createdAt  DateTime @default(now()) @map("created_at")

  class    Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  behavior BehaviorTemplate? @relation(fields: [behaviorId], references: [id], onDelete: SetNull)
  teacher  User?             @relation("BehaviorTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  student  User              @relation("BehaviorStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teamAward TeamAward?        @relation(fields: [teamAwardId], references: [id], onDelete: SetNull)

  @@index([classId])
  @@index([studentId, classId])
  @@index([teamAwardId])
  @@map("behavior_applications")
}

// ==================== ASISTENCIA (Fase 3, bloque 4, D1) ====================

// Una sesión es cada vez que se da la clase: clase + fecha + tramo. Se crea al
// guardar la lista, nunca por adelantado; el horario solo la propone. La fecha
// la manda el navegador (día local), no se deriva del reloj del servidor.
// `startTime` es "" en la sesión sin horario, a propósito: con un nulo, el
// único no impediría dos «Sesión de hoy» el mismo día.
enum AttendanceStatus {
  present
  absent
  late
  excused
}

model AttendanceSession {
  id        String   @id @default(uuid())
  classId   String   @map("class_id")
  date      DateTime @db.Date
  startTime String   @default("") @map("start_time") // "HH:MM" del tramo; "" = sin horario
  endTime   String?  @map("end_time")
  source    String   @default("manual") // "schedule" | "manual"
  // Quién pasó lista por última vez. Si esa cuenta se borra, la sesión se conserva.
  takenById String?  @map("taken_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  class   Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  takenBy User?              @relation("AttendanceTakenBy", fields: [takenById], references: [id], onDelete: SetNull)
  records AttendanceRecord[]

  @@unique([classId, date, startTime])
  @@map("attendance_sessions")
}

// El estado de una persona en una sesión. Cuelga de la matrícula: sacar a
// alguien de la clase borra su asistencia (es un dato personal de menores).
model AttendanceRecord {
  id           String           @id @default(uuid())
  sessionId    String           @map("session_id")
  enrollmentId String           @map("enrollment_id")
  status       AttendanceStatus @default(present)
  note         String?
  updatedById  String?          @map("updated_by_id")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  session    AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment ClassEnrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  updatedBy  User?             @relation("AttendanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, enrollmentId])
  @@index([enrollmentId])
  @@map("attendance_records")
}

// ---- Equipos (bloque 4, D2) ----

/// Una forma de repartir la clase en equipos. Puede haber varias a la vez: las
/// de base (fijas; las únicas que puntúan en la clasificación) y temporales,
/// para una misión o una dinámica, que se archivan al acabar.
model TeamSet {
  id         String    @id @default(uuid())
  classId    String    @map("class_id")
  title      String
  kind       String    @default("base") // "base" | "temporal"
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  class    Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  teams    Team[]
  missions Mission[]

  @@index([classId])
  @@map("team_sets")
}

/// Un equipo de una agrupación. El color y el emblema son claves de una lista
/// cerrada (la paleta de tokens y los emblemas predefinidos), nunca un valor
/// libre: así responden a los modos de daltonismo y alto contraste.
model Team {
  id         String  @id @default(uuid())
  setId      String  @map("set_id")
  title      String
  color      String?
  emblem     String?
  orderIndex Int     @default(0) @map("order_index")

  set     TeamSet      @relation(fields: [setId], references: [id], onDelete: Cascade)
  members TeamMember[]
  awards  TeamAward[]

  // La pertenencia apunta a la pareja equipo + agrupación: así la base de datos
  // impide que la agrupación de la pertenencia no sea la de su equipo.
  @@unique([id, setId])
  @@index([setId])
  @@map("teams")
}

/// Pertenencia a un equipo. Cuelga de la matrícula: sacar a alguien de la clase
/// la borra sola. Nadie está en dos equipos de la misma agrupación.
model TeamMember {
  id           String @id @default(uuid())
  teamId       String @map("team_id")
  setId        String @map("set_id")
  enrollmentId String @map("enrollment_id")

  team       Team            @relation(fields: [teamId, setId], references: [id, setId], onDelete: Cascade)
  enrollment ClassEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([setId, enrollmentId])
  @@index([teamId])
  @@index([enrollmentId])
  @@map("team_members")
}

/// Premio a un equipo: el marcador es la suma de `points` (un libro, no un
/// contador, para que no se descuadre al mover a alguien). Los deltas son lo
/// repartido a cada integrante, o 0 si solo puntuó; `memberCount`, a cuántos.
model TeamAward {
  id          String   @id @default(uuid())
  teamId      String   @map("team_id")
  // Quién premió. Si esa cuenta se borra, el premio se conserva sin autor.
  teacherId   String?  @map("teacher_id")
  behaviorId  String?  @map("behavior_id")
  title       String // nombre del comportamiento o motivo, copiado
  points      Int      @default(0)
  xpDelta     Int      @default(0) @map("xp_delta")
  coinDelta   Int      @default(0) @map("coin_delta")
  manaDelta   Int      @default(0) @map("mana_delta")
  lifeDelta   Int      @default(0) @map("life_delta")
  memberCount Int      @default(0) @map("member_count")
  createdAt   DateTime @default(now()) @map("created_at")

  team         Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teacher      User?                 @relation("TeamAwardTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  behavior     BehaviorTemplate?     @relation(fields: [behaviorId], references: [id], onDelete: SetNull)
  applications BehaviorApplication[]

  @@index([teamId])
  @@map("team_awards")
}

// ==================== CENTRO DE AYUDA (Fase 3, punto 17) ====================

// El motor de contenidos es genérico a propósito: hoy solo sirve la ayuda, pero
// el día que el blog se traiga de gamifp.es o lleguen los cursos de formación,
// entran como otro tipo de contenido sin migrar nada.

enum HelpArticleStatus {
  borrador
  publicado
}

/** A quién va dirigido un artículo. `ambos` sale en las dos portadas. */
enum HelpAudience {
  profesor
  alumno
  ambos
}

/** Forma del contenido. `video` pinta `videoUrl` encima del cuerpo y exige URL para publicarse. */
enum HelpArticleKind {
  guia
  tutorial
  faq
  video
}

/** Área editorial de una categoría; sus artículos la heredan. */
enum HelpArea {
  ayuda
  blog
}

model HelpCategory {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  /** Nombre del icono del sistema de diseño (ver `app/utils/help-icons.ts`). */
  icon        String?
  /** Tipo de `Card` del sistema de diseño: ia, stats, clases o pending. */
  accent      String   @default("stats")
  /** Área editorial. La ayuda pública solo lista `ayuda`; el blog tendrá su propia superficie. */
  area        HelpArea @default(ayuda)
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  articles HelpArticle[]

  @@index([area, orderIndex])
  @@map("help_categories")
}

model HelpArticle {
  id         String            @id @default(uuid())
  categoryId String            @map("category_id")
  slug       String
  title      String
  summary    String?
  /**
   * Imagen de portada del artículo: sale arriba del cuerpo y como miniatura en
   * los listados. Guarda la URL que devuelve la capa de almacenamiento, así que
   * vale igual para disco local que para R2.
   */
  coverImage String?           @map("cover_image")
  /** Cuerpo en markdown; se pinta con el mismo `.md-rendered` que el resto. */
  body       String            @db.Text
  /**
   * Idioma del artículo. De momento todo va en castellano y la interfaz se
   * traduce sola; la columna está desde el principio para que traducir después
   * no obligue a migrar.
   */
  locale     String            @default("es")
  status     HelpArticleStatus @default(borrador)
  orderIndex Int               @default(0) @map("order_index")
  /** Aparece en «lo más consultado» de la portada. Curado, no automático. */
  featured   Boolean           @default(false)
  /** Audiencia. Por defecto profesorado: es lo que era todo el contenido hasta ahora. */
  audience   HelpAudience      @default(profesor)
  /** Tipo editorial. `video` solo aloja la URL: el vídeo se aloja fuera de la plataforma. */
  kind       HelpArticleKind   @default(guia)
  /** URL https de YouTube, Vimeo o fichero .mp4/.webm. Solo se guarda si `kind = video`. */
  videoUrl   String?           @map("video_url")
  views      Int               @default(0)
  helpful    Int               @default(0)
  notHelpful Int               @default(0) @map("not_helpful")

  /**
   * Vector de búsqueda generado por la base de datos (título, resumen y cuerpo
   * con pesos distintos) con una configuración castellana que ignora tildes.
   * Prisma no sabe leer este tipo; se consulta con SQL en `help.service.ts`.
   */
  searchVector Unsupported("tsvector")? @map("search_vector")

  /**
   * Firma de una entrada del blog, en texto libre («Equipo ITAKAI», una
   * invitada…): no apunta a ninguna cuenta. Solo la enseña el blog.
   */
  authorName  String?   @map("author_name")
  /**
   * Primera publicación. La pone el sistema al publicar por primera vez y no
   * cambia al retirar y volver a publicar; en el blog se puede corregir desde
   * el panel (entradas antiguas traídas con su fecha real).
   */
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug, locale])
  @@index([status, locale])
  @@index([categoryId, orderIndex])
  @@map("help_articles")
}
