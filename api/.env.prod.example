# Production environment variables
# Copy this file to .env.prod and fill in the values

# Database password (CHANGE THIS!)
DB_PASSWORD=your_secure_password_here

# JWT secrets (generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# Token expiration
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS origins (comma-separated)
CORS_ORIGIN=https://itakai.es,https://www.itakai.es

# De qué proxy se fía la API para saber la dirección real del cliente
# (X-Forwarded-For). Por defecto (`private`): solo del salto inmediato, y solo si
# llega desde una red privada, que es el nginx del compose. Con otro proxy
# delante, el número de saltos (2) o sus direcciones separadas por comas; sin
# proxy, false. El valor por defecto supone que el puerto de la API no se
# publica; si se publica, las direcciones exactas del proxy.
# TRUST_PROXY=private

# IA — valores de arranque. Lo que se guarde en Admin → Configuración → IA
# tiene prioridad. Endpoints compatibles con OpenAI: la base puede ser el host
# (se añade /v1) o una base ya versionada (…/v1, …/v4).
SPARK_ROUTER_BASE_URL=https://your-openai-compatible-endpoint
SPARK_ROUTER_API_KEY=your_text_and_image_api_key
SPARK_ROUTER_MODEL=your_text_model
SPARK_ROUTER_IMAGE_MODEL=your_image_model
